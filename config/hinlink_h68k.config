# =====================================================
# ImmortalWrt 定制固件 seed 配置 — HINLINK H68K (F版 WiFi)
# 目标：tailscale + lucky + Samba + 文件管理器 + OpenClash + CUPS + iStore 商店
# =====================================================

# ---------- 平台 / 设备 ----------
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_h66k=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_h68k=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_TARGZ=n

# ---------- LuCI 基本 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-compat=y

# ---------- 无线（MT7921，profile 已含 wpad-basic-mbedtls，这里双保险） ----------
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ---------- 网口驱动（RTL8125 2.5G + PHY，profile 已含，双保险） ----------
CONFIG_PACKAGE_kmod-r8169=y

# ---------- Tailscale 内网穿透 ----------
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y

# ---------- Lucky（DDNS/反代/端口转发） ----------
CONFIG_PACKAGE_luci-app-lucky=y

# ---------- Samba 文件共享 ----------
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# ---------- 文件管理器 ----------
CONFIG_PACKAGE_luci-app-filemanager=y

# ---------- iStore 应用商店 ----------
CONFIG_PACKAGE_luci-app-store=y

# ---------- OpenClash ----------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq_full=y
# 用 dnsmasq-full 顶掉基础版，避免与 OpenClash 冲突
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcping=y

# ---------- CUPS 打印服务（USB + 网络打印机，管理页 http://路由器IP:631） ----------
CONFIG_PACKAGE_cups=y
CONFIG_PACKAGE_cups-filters=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_avahi-utils=y

# ---------- USB 存储 / 磁盘挂载（SMB+文件管理器配套） ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y

# ---------- 常用小工具 / 基础网络 ----------
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
